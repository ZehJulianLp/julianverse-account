# Generate secrets and the OIDC signing key with: flask --app wsgi init-secrets
ACCOUNT_ENV=development
ACCOUNT_BASE_URL=http://localhost:8096
ACCOUNT_SECRET_KEY=
ACCOUNT_ENCRYPTION_KEY=
# Stable files in instance/. Back these up with the SQLite database.
ACCOUNT_SIGNING_KEY=instance/oidc-private.pem
ACCOUNT_DATABASE_URL=sqlite:///account.sqlite3
ACCOUNT_REGISTRATION_OPEN=true
# Keep true in production; registration sends a verification email.
ACCOUNT_REQUIRE_VERIFIED_EMAIL=true
ACCOUNT_TRUST_PROXY=false

# Fixed server URL; users cannot configure arbitrary WebDAV destinations.
OWNCLOUD_BASE_URL=https://cloud.julianverse.de
OWNCLOUD_SYNC_ROOT=Julianverse

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Redirect in Discord: https://account.julianverse.de/auth/discord/callback

MAIL_HOST=
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USE_STARTTLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Julianverse Account <account@julianverse.de>
